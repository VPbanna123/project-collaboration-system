# Team Service Environment Variables
# Database: team_db (port: 5433)

# ============================================
# HTTP/REST API SERVER (External)
# ============================================
PORT=3002

# ============================================
# gRPC SERVER (Internal Communication)
# ============================================
GRPC_PORT=50002

NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/team_db?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Internal Authentication (API Gateway Pattern)
# This secret is shared across all services and the API Gateway
# ❌ DO NOT use CLERK_SECRET_KEY here - only Gateway needs it!
INTERNAL_JWT_SECRET=your-super-secret-internal-key-change-in-production

# Resend Email Service
# Get your API key from: https://resend.com/api-keys
# Free tier: 100 emails/day, 3,000 emails/month
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=Team App <onboarding@resend.dev>

# Application URL (for invitation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# INTER-SERVICE COMMUNICATION
# ============================================
# HTTP/REST URLs (Legacy - will be replaced by gRPC)
USER_SERVICE_URL=http://localhost:3001
PROJECT_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3005

# gRPC Service Addresses (Internal Communication)
USER_SERVICE_GRPC=localhost:50001
PROJECT_SERVICE_GRPC=localhost:50003
NOTIFICATION_SERVICE_GRPC=localhost:50005

CHAT_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005
