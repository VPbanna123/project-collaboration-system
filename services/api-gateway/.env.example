# API Gateway Configuration
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Clerk Authentication (ONLY in API Gateway - not in other services!)
# Get this from: https://dashboard.clerk.com/
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Internal Security
# Generate secure random strings for production:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
INTERNAL_JWT_SECRET=change-this-to-a-very-long-random-secret-in-production-min-64-chars
INTERNAL_API_KEY=change-this-api-key-to-something-secure-in-production

# Redis Configuration
REDIS_URL=redis://redis:6379

# ========================================
# HTTP/REST API URLS - External Communication
# ========================================
# These are used for webhooks, health checks, and legacy HTTP endpoints
# Microservice URLs (Docker internal DNS)
# These use service names from docker-compose.yml
USER_SERVICE_URL=http://user-service:3001
TEAM_SERVICE_URL=http://team-service:3002
PROJECT_SERVICE_URL=http://project-service:3003
CHAT_SERVICE_URL=http://chat-service:3004
NOTIFICATION_SERVICE_URL=http://notification-service:3005

# ========================================
# gRPC SERVICE ADDRESSES - Internal Communication
# ========================================
# These are used for internal microservice-to-microservice communication
# Format: service-name:grpc-port (50001-50005)
# These provide better performance and type safety compared to HTTP
GRPC_USER_SERVICE=user-service:50001
GRPC_TEAM_SERVICE=team-service:50002
GRPC_PROJECT_SERVICE=project-service:50003
GRPC_CHAT_SERVICE=chat-service:50004
GRPC_NOTIFICATION_SERVICE=notification-service:50005

# Rate Limiting (requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
