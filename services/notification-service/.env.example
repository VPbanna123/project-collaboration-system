# Notification Service Environment Variables
# Database: notification_db (port: 5436)

# ============================================
# HTTP/REST API SERVER (External)
# ============================================
PORT=3005

# ============================================
# gRPC SERVER (Internal Communication)
# ============================================
GRPC_PORT=50005

DATABASE_URL="postgresql://postgres:postgres@localhost:5436/notification_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Internal Authentication (API Gateway Pattern)
# ❌ DO NOT use CLERK_SECRET_KEY here - only API Gateway needs it!
INTERNAL_JWT_SECRET=your-super-secret-internal-key-change-in-production

# ============================================
# INTER-SERVICE COMMUNICATION
# ============================================
# HTTP/REST URLs (Legacy - will be replaced by gRPC)
USER_SERVICE_URL=http://localhost:3001
TEAM_SERVICE_URL=http://localhost:3002
PROJECT_SERVICE_URL=http://localhost:3003
CHAT_SERVICE_URL=http://localhost:3004

# gRPC Service Addresses (Internal Communication)
USER_SERVICE_GRPC=localhost:50001
TEAM_SERVICE_GRPC=localhost:50002
PROJECT_SERVICE_GRPC=localhost:50003
CHAT_SERVICE_GRPC=localhost:50004
